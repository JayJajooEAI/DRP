# Track the code, READMEs and small model files of both incident types and the shared server.
# Left out: every data/ and outputs/ folder, virtualenvs, secrets, sample screenshots, and the weight files over GitHub's 100 MB limit.
/*
!/.gitignore
!/README.md
!/DataSchema.md
!/development/
!/inference/

# development: both incident types, without their data, run outputs or virtualenv
/development/*
!/development/impersonation/
!/development/WebPhish/
/development/WebPhish/data/
/development/WebPhish/outputs/
/development/WebPhish/.venv/
!/development/PhysicalThreatFacility/
!/development/SuspiciousDomain/
/development/SuspiciousDomain/data/
/development/SuspiciousDomain/outputs/
/development/PhysicalThreatFacility/data/
/development/PhysicalThreatFacility/outputs/
/development/impersonation/data/*
!/development/impersonation/data/README.md
!/development/impersonation/data/assets/
/development/impersonation/data/assets/*
!/development/impersonation/data/assets/README.md
!/development/impersonation/data/reference/
/development/impersonation/data/reference/*
!/development/impersonation/data/reference/README.md
!/development/impersonation/data/screenshots/
/development/impersonation/data/screenshots/*
!/development/impersonation/data/screenshots/README.md
/development/impersonation/outputs/
/development/impersonation/.venv/

# inference: the shared server files and both incident-type folders (not impersonation's sample screenshots)
/inference/*
!/inference/app.py
!/inference/README.md
!/inference/requirements.txt
!/inference/smoke_test.py
!/inference/.env.example
!/inference/impersonation/
/inference/impersonation/samples/
!/inference/WebPhish/
!/inference/PhysicalThreatFacility/
!/inference/SuspiciousDomain/

# WebPhish weight files over 100 MB (the language models and the Phishpedia logo models); copy them in by hand
/inference/WebPhish/model/check2/model/model.safetensors
/inference/WebPhish/model/check3/model/model.safetensors
/inference/WebPhish/model/phishpedia/*.pth
/inference/WebPhish/model/phishpedia/*.pth.tar

# Physical-threat weight files (over 100 MB)
/inference/PhysicalThreatFacility/model/rung1_location/model.safetensors
/inference/PhysicalThreatFacility/model/rung2_distilbert/model.safetensors

__pycache__/
*.pyc
.pytest_cache/

# Secrets and local settings: never commit
.env
*.env
